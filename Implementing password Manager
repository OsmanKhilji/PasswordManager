import java.util.HashMap;
import java.util.Scanner;

public class PasswordManagerAddEntry {
    private HashMap<String, String> passwordEntries;

    public PasswordManagerAddEntry() {
        passwordEntries = new HashMap<>();
    }

    public void addEntry(String site, String password) {
        passwordEntries.put(site, password);
    System.out.println("Entry added: " + site + " Site-Password " + password);
    }

    public static void main(String[] args) {
        PasswordManagerAddEntry manager = new PasswordManagerAddEntry();
        Scanner scanner = new Scanner(System.in);

        System.out.println("Password Manager: Add New Entry");
        System.out.print("Enter site name: ");
        String site = scanner.nextLine();

        System.out.print("Enter password: ");
        String password = scanner.nextLine();

        manager.addEntry(site, password);

        System.out.println("Your password entry has been saved");

        scanner.close();
    }
}
